/* =====================================================
   ODICART — ODISHA STARTUP DESIGN
===================================================== */

:root {

  --cream:#fff5e5;
  --cream2:#f9e6cc;

  --brown:#542719;
  --dark:#24140e;

  --orange:#e94f22;
  --orange2:#f47735;

  --green:#237b42;
  --green2:#4b963f;

  --yellow:#e6a72c;

  --white:#ffffff;
  --muted:#77675c;

}

* {
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html {
  scroll-behavior:smooth;
}

body {

  font-family:"DM Sans",sans-serif;

  background:var(--cream);

  color:var(--brown);

  overflow-x:hidden;

}

h1,h2,h3 {

  font-family:"Playfair Display",serif;

}

a {
  text-decoration:none;
  color:inherit;
}

button,
input,
textarea,
select {
  font-family:inherit;
}


/* =====================================================
   NAVBAR
===================================================== */

.navbar {

  height:82px;

  padding:0 6%;

  display:flex;

  align-items:center;

  justify-content:space-between;

  position:sticky;

  top:0;

  z-index:1000;

  background:rgba(255,245,229,.94);

  backdrop-filter:blur(15px);

  border-bottom:1px solid rgba(84,39,25,.1);

}

.brand {

  display:flex;

  flex-direction:column;

}

.brand-logo {

  font-size:29px;

  font-weight:800;

  line-height:1;

}

.brand-logo span {
  color:#3b2016;
}

.brand-logo b {
  color:var(--orange);
}

.brand-logo i {
  font-style:normal;
  font-size:20px;
}

.brand small {

  font-family:"Caveat",cursive;

  font-size:12px;

  color:var(--brown);

  margin-top:3px;

}

.navbar nav {

  display:flex;

  gap:30px;

  font-size:13px;

  font-weight:700;

}

.navbar nav a {

  transition:.3s;

}

.navbar nav a:hover {

  color:var(--orange);

}

.nav-right {

  display:flex;

  gap:10px;

}

.cart-btn,
.menu-btn {

  border:none;

  cursor:pointer;

  width:42px;

  height:42px;

  border-radius:50%;

  background:var(--white);

  box-shadow:0 5px 20px rgba(84,39,25,.1);

}

.cart-btn {

  position:relative;

}

.cart-btn span {

  position:absolute;

  right:-3px;

  top:-3px;

  width:18px;

  height:18px;

  display:grid;

  place-items:center;

  border-radius:50%;

  background:var(--orange);

  color:white;

  font-size:9px;

}

.menu-btn {
  display:none;
}


/* =====================================================
   HERO
===================================================== */

.hero {

  min-height:700px;

  padding:80px 9%;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:40px;

  position:relative;

  overflow:hidden;

  background:

    radial-gradient(
      circle at 10% 20%,
      #f9d5a3,
      transparent 30%
    ),

    var(--cream);

}

.paint {

  position:absolute;

  border-radius:50%;

  filter:blur(1px);

  opacity:.35;

}

.orange-paint {

  width:500px;
  height:160px;

  background:#e87439;

  left:-160px;
  top:80px;

  transform:rotate(-18deg);

}

.green-paint {

  width:500px;
  height:180px;

  background:#57934a;

  right:-230px;
  bottom:-70px;

  transform:rotate(-15deg);

}

.temple-decoration {

  position:absolute;

  left:20px;

  top:20px;

  font-size:130px;

  opacity:.12;

  filter:sepia(1);

}

.hero-text {

  max-width:650px;

  position:relative;

  z-index:2;

}

.mini-title {

  color:var(--orange);

  font-size:11px;

  font-weight:800;

  letter-spacing:2.5px;

}

.hero h1 {

  font-size:clamp(50px,6vw,86px);

  line-height:.98;

  margin:18px 0 25px;

  letter-spacing:-3px;

}

.hero h1 span,
.section-heading span,
.about-text span,
.final-cta span {

  color:var(--orange);

}

.hero-text > p {

  max-width:550px;

  color:var(--muted);

  line-height:1.8;

  font-size:16px;

}

.hero-buttons {

  display:flex;

  gap:13px;

  margin-top:30px;

}

.primary-btn {

  background:var(--orange);

  color:white;

  padding:15px 24px;

  border-radius:8px;

  font-weight:800;

  box-shadow:0 12px 30px rgba(233,79,34,.25);

  transition:.3s;

}

.primary-btn:hover {

  transform:translateY(-4px);

}

.secondary-btn {

  padding:14px 22px;

  border:1px solid #cbb49f;

  border-radius:8px;

  font-weight:700;

}

.hero-note {

  margin-top:35px;

  font-family:"Caveat",cursive;

  font-size:18px;

  color:var(--green);

}


/* HERO FOOD */

.hero-food {

  width:490px;

  height:490px;

  position:relative;

  display:grid;

  place-items:center;

}

.food-shadow {

  position:absolute;

  width:360px;

  height:90px;

  bottom:40px;

  background:rgba(60,25,10,.2);

  filter:blur(25px);

  border-radius:50%;

}

.food-plate {

  width:390px;

  height:390px;

  border-radius:50%;

  overflow:hidden;

  border:16px solid white;

  box-shadow:

    0 30px 60px rgba(84,39,25,.22),

    0 0 0 2px #e8d3b9;

  transform:rotate(-4deg);

  animation:plate 5s ease-in-out infinite;

}

.food-plate img {

  width:100%;
  height:100%;
  object-fit:cover;

}

@keyframes plate {

  0%,100% {
    transform:rotate(-4deg) translateY(0);
  }

  50% {
    transform:rotate(3deg) translateY(-12px);
  }

}

.floating-tag {

  position:absolute;

  background:white;

  padding:12px 17px;

  border-radius:30px;

  box-shadow:0 12px 30px rgba(84,39,25,.15);

  font-weight:800;

  font-size:12px;

  animation:float 4s ease-in-out infinite;

}

.tag-one {
  left:10px;
  top:80px;
}

.tag-two {
  right:0;
  top:25px;
  animation-delay:1s;
}

.tag-three {
  right:10px;
  bottom:65px;
  animation-delay:2s;
}

@keyframes float {

  0%,100% {
    transform:translateY(0);
  }

  50% {
    transform:translateY(-12px);
  }

}


/* =====================================================
   BRAND STRIP
===================================================== */

.brand-strip {

  background:var(--brown);

  color:white;

  display:flex;

  justify-content:center;

  align-items:center;

  gap:25px;

  padding:17px;

  overflow:hidden;

  font-size:11px;

  font-weight:800;

  letter-spacing:1px;

}

.brand-strip b {
  color:#e6a72c;
}


/* =====================================================
   APP SECTION
===================================================== */

.app-section {

  padding:120px 6%;

  background:

    radial-gradient(
      circle at 10% 90%,
      #f5d59c,
      transparent 25%
    ),

    var(--cream);

}

.section-heading {

  text-align:center;

  max-width:700px;

  margin:0 auto 70px;

}

.section-heading h2 {

  font-size:55px;

  line-height:1;

  margin:12px 0 20px;

}

.section-heading p {

  color:var(--muted);

  line-height:1.7;

}


/* PHONES */

.phones-wrapper {

  display:flex;

  justify-content:center;

  align-items:flex-start;

  gap:18px;

}

.phone-card {

  text-align:center;

}

.phone-label {

  font-family:"Caveat",cursive;

  font-size:20px;

  margin-bottom:12px;

  color:var(--brown);

}

.phone {

  width:250px;

  height:530px;

  background:#fdfaf4;

  border:8px solid #2b211c;

  border-radius:35px;

  overflow:hidden;

  position:relative;

  box-shadow:

    0 20px 40px rgba(84,39,25,.2),

    0 0 0 2px #b78e6e;

  text-align:left;

}

.phone-main {

  transform:translateY(-35px);

}

.notch {

  position:absolute;

  width:95px;

  height:20px;

  border-radius:0 0 15px 15px;

  background:#1b1715;

  left:50%;

  transform:translateX(-50%);

  z-index:5;

}

.app-top {

  padding:30px 13px 8px;

  display:flex;

  justify-content:space-between;

}

.app-top strong {

  font-size:18px;

}

.mini-logo {

  display:inline-grid;

  place-items:center;

  width:22px;

  height:22px;

  background:var(--orange);

  color:white;

  border-radius:50%;

  font-size:11px;

}

.location {

  padding:3px 13px;

  font-size:9px;

  color:#777;

}

.search {

  margin:8px 10px;

  padding:10px;

  border-radius:8px;

  background:#f2eee7;

  color:#999;

  font-size:8px;

}

.app-banner {

  margin:8px 10px;

  height:100px;

  padding:17px;

  border-radius:9px;

  color:white;

  background:

    linear-gradient(
      90deg,
      rgba(55,25,10,.8),
      rgba(55,25,10,.1)
    ),

    url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=700&q=80")
    center/cover;

}

.app-banner div {

  display:flex;

  flex-direction:column;

}

.app-banner small {

  font-size:7px;

}

.app-banner strong {

  font-size:17px;

}

.app-banner em {

  font-size:7px;

  margin-top:3px;

}

.phone h4 {

  padding:5px 12px;

  font-size:11px;

}

.app-categories {

  display:grid;

  grid-template-columns:repeat(4,1fr);

  padding:5px 9px 10px;

  gap:6px;

}

.app-categories div {

  text-align:center;

  font-size:24px;

}

.app-categories small {

  display:block;

  font-size:7px;

  margin-top:3px;

}

.mini-product {

  margin:0 10px;

  padding:7px;

  border:1px solid #eee5da;

  border-radius:9px;

  display:flex;

  align-items:center;

  gap:7px;

}

.mini-product img {

  width:48px;
  height:48px;

  object-fit:cover;

  border-radius:7px;

}

.mini-product div {

  flex:1;

  display:flex;

  flex-direction:column;

}

.mini-product strong {

  font-size:9px;

}

.mini-product small {

  font-size:7px;

  color:#999;

}

.mini-product b {

  color:var(--orange);

  font-size:9px;

}

.mini-product button {

  border:none;

  background:var(--orange);

  color:white;

  border-radius:5px;

  width:25px;

  height:25px;

}

.hidden-odisha {

  margin:10px;

  padding:10px;

  border-radius:8px;

  background:#e9f0e4;

}

.hidden-odisha strong {

  font-size:9px;

  display:block;

}

.hidden-odisha small {

  font-size:7px;

  color:#777;

}

.phone-nav {

  position:absolute;

  bottom:0;

  left:0;

  right:0;

  height:45px;

  background:white;

  border-top:1px solid #eee;

  display:grid;

  grid-template-columns:repeat(4,1fr);

  text-align:center;

  padding-top:5px;

}

.phone-nav span {

  font-size:14px;

}

.phone-nav small {

  display:block;

  font-size:6px;

}

.app-header {

  padding:30px 12px 10px;

  display:flex;

  justify-content:space-between;

  font-size:11px;

}

.detail-image {

  width:100%;

  height:150px;

  object-fit:cover;

}

.detail-content {

  padding:13px;

}

.detail-content h2 {

  font-size:22px;

}

.detail-content > small {

  color:#888;

  font-size:8px;

}

.rating {

  color:#e99b20;

  font-size:9px;

  margin:8px 0;

}

.rating span {

  color:#888;

}

.price {

  float:right;

  font-size:18px;

}

.detail-content p {

  clear:both;

  padding-top:10px;

  font-size:8px;

  color:#666;

  line-height:1.6;

}

.detail-content h5 {

  font-size:9px;

  margin-top:10px;

}

.quantity {

  display:flex;

  align-items:center;

  gap:14px;

  margin-top:5px;

}

.quantity button {

  width:23px;
  height:23px;

  border:1px solid #ddd;

  background:white;

  border-radius:5px;

}

.add-large {

  width:100%;

  border:none;

  background:var(--orange);

  color:white;

  padding:11px;

  margin-top:10px;

  border-radius:7px;

  font-size:9px;

  font-weight:800;

}

.also-try {

  display:flex;

  gap:10px;

}

.also-try div {

  background:#f7f1e8;

  padding:8px;

  border-radius:8px;

  font-size:20px;

  width:80px;

}

.also-try small,
.also-try b {

  display:block;

  font-size:7px;

}

.cart-product {

  display:flex;

  gap:10px;

  padding:12px;

  border-bottom:1px solid #eee;

}

.cart-product img {

  width:50px;
  height:50px;

  object-fit:cover;

  border-radius:7px;

}

.cart-product div {

  display:flex;

  flex-direction:column;

}

.cart-product strong {
  font-size:10px;
}

.cart-product span {
  font-size:9px;
  color:var(--orange);
  font-weight:bold;
}

.small-quantity {

  margin-top:5px;

  font-size:8px;

  border:1px solid #ddd;

  padding:4px;

  border-radius:5px;

}

.cart-summary {

  position:absolute;

  left:12px;
  right:12px;
  bottom:15px;

}

.cart-summary div {

  display:flex;

  justify-content:space-between;

  padding:5px 0;

  font-size:8px;

}

.cart-summary hr {

  border:none;

  border-top:1px solid #ddd;

}

.cart-summary .total {

  font-size:11px;

  margin:5px 0;

}

.cart-summary button,
.order-block button {

  width:100%;

  padding:11px;

  border:none;

  border-radius:7px;

  background:var(--orange);

  color:white;

  font-size:9px;

  font-weight:800;

}

.order-block {

  padding:10px 13px;

}

.order-block h4 {

  font-size:10px;

  margin:12px 0 7px;

}

.address {

  display:flex;

  gap:7px;

  background:#f6f0e7;

  padding:8px;

  border-radius:7px;

}

.address strong,
.address small {

  display:block;

  font-size:8px;

}

.order-block label {

  display:block;

  font-size:8px;

  padding:5px 0;

}

.summary-line {

  display:flex;

  justify-content:space-between;

  font-size:8px;

  padding:5px 0;

}

.summary-line.grand {

  font-size:11px;

  margin:5px 0;

}


/* =====================================================
   BENEFITS
===================================================== */

.benefits {

  padding:70px 8%;

  display:grid;

  grid-template-columns:repeat(4,1fr);

  gap:20px;

  background:#f8dfc3;

  position:relative;

}

.benefit {

  text-align:center;

}

.benefit > div {

  width:65px;
  height:65px;

  display:grid;
  place-items:center;

  margin:auto;

  border-radius:50%;

  background:white;

  font-size:28px;

}

.benefit h3 {

  font-size:19px;

  margin:12px 0 5px;

}

.benefit p {

  color:#806e61;

  font-size:11px;

  line-height:1.5;

}


/* =====================================================
   CATEGORIES
===================================================== */

.categories {

  padding:120px 8%;

}

.category-grid {

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:20px;

}

.category {

  min-height:350px;

  border-radius:20px;

  padding:35px;

  position:relative;

  overflow:hidden;

  transition:.4s;

}

.category:hover {

  transform:translateY(-10px);

}

.category-one {

  background:#ed9d5c;

}

.category-two {

  background:#e96d55;

  color:white;

}

.category-three {

  background:#4b8b4c;

  color:white;

}

.category-number {

  font-size:11px;

  font-weight:800;

  opacity:.6;

}

.category-icon {

  font-size:65px;

  margin:40px 0 20px;

}

.category h3 {

  font-size:28px;

}

.category p {

  font-size:12px;

  line-height:1.7;

  margin:10px 0 25px;

  max-width:300px;

}

.category a {

  font-weight:800;

  font-size:12px;

}


/* =====================================================
   FOODS
===================================================== */

.foods {

  padding:120px 8%;

  background:white;

}

.centered {
  text-align:center;
}

.food-grid {

  display:grid;

  grid-template-columns:repeat(4,1fr);

  gap:20px;

}

.food-card {

  border:1px solid #eadfd3;

  border-radius:17px;

  overflow:hidden;

  background:white;

  transition:.35s;

}

.food-card:hover {

  transform:translateY(-8px);

  box-shadow:0 20px 40px rgba(84,39,25,.12);

}

.food-image {

  height:210px;

  position:relative;

  overflow:hidden;

}

.food-image img {

  width:100%;
  height:100%;

  object-fit:cover;

  transition:.5s;

}

.food-card:hover img {

  transform:scale(1.08);

}

.food-image span {

  position:absolute;

  top:12px;
  left:12px;

  background:white;

  padding:6px 9px;

  border-radius:20px;

  font-size:8px;

  font-weight:800;

}

.food-info {

  padding:20px;

}

.food-info h3 {

  font-size:20px;

}

.food-info p {

  color:#88796d;

  font-size:10px;

  line-height:1.6;

  min-height:34px;

  margin:8px 0 18px;

}

.food-info > div {

  display:flex;

  justify-content:space-between;

  align-items:center;

}

.food-info strong {

  font-size:20px;

}

.food-info button {

  border:none;

  background:var(--orange);

  color:white;

  padding:9px 12px;

  border-radius:7px;

  cursor:pointer;

  font-size:9px;

  font-weight:800;

}


/* =====================================================
   FESTIVALS
===================================================== */

.festivals {

  padding:110px 8%;

  color:white;

  background:

    linear-gradient(
      120deg,
      rgba(52,31,19,.96),
      rgba(35,86,43,.95)
    );

  display:grid;

  grid-template-columns:.8fr 1.2fr;

  gap:80px;

}

.festival-intro h2 {

  font-size:60px;

  line-height:1;

  margin:15px 0;

}

.festival-intro h2 span {

  color:#e9a332;

}

.festival-intro p {

  color:#d4c9c0;

  max-width:430px;

  line-height:1.7;

}

.festival-list {

  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:15px;

}

.festival-list div {

  padding:25px;

  border:1px solid rgba(255,255,255,.15);

  border-radius:15px;

  background:rgba(255,255,255,.06);

  transition:.3s;

}

.festival-list div:hover {

  background:rgba(255,255,255,.12);

  transform:translateY(-5px);

}

.festival-list span {

  font-size:32px;

  display:block;

  margin-bottom:15px;

}

.festival-list strong,
.festival-list small {

  display:block;

}

.festival-list strong {

  font-family:"Playfair Display";

  font-size:20px;

}

.festival-list small {

  color:#bcb2a9;

  font-size:9px;

  margin-top:5px;

}


/* =====================================================
   ABOUT
===================================================== */

.about {

  padding:130px 10%;

  display:grid;

  grid-template-columns:1fr 1fr;

  align-items:center;

  gap:100px;

}

.about-art {

  height:450px;

  position:relative;

  display:grid;

  place-items:center;

}

.paint-circle {

  width:350px;
  height:350px;

  border-radius:50%;

  background:#e8a248;

  box-shadow:40px 35px 0 var(--green);

  transform:rotate(-7deg);

}

.about-food {

  position:absolute;

  font-size:150px;

  filter:drop-shadow(0 20px 15px rgba(84,39,25,.2));

}

.heritage-stamp {

  position:absolute;

  right:20px;

  bottom:30px;

  width:110px;
  height:110px;

  display:grid;
  place-items:center;

  text-align:center;

  border-radius:50%;

  background:var(--brown);

  color:white;

  font-size:11px;

  font-weight:800;

  transform:rotate(10deg);

}

.about-text h2 {

  font-size:58px;

  line-height:1;

  margin:15px 0 25px;

}

.about-text p {

  color:var(--muted);

  line-height:1.8;

  margin-bottom:15px;

}

.signature {

  margin-top:25px;

  font-family:"Caveat",cursive;

  color:var(--green);

  font-size:25px;

}


/* =====================================================
   CTA
===================================================== */

.final-cta {

  margin:0 7% 100px;

  min-height:300px;

  border-radius:25px;

  background:

    linear-gradient(
      120deg,
      #e75a2e,
      #b33f27
    );

  color:white;

  display:flex;

  align-items:center;

  justify-content:center;

  gap:80px;

  overflow:hidden;

  position:relative;

}

.cta-food {

  font-size:170px;

  transform:rotate(-15deg);

  animation:float 4s infinite;

}

.final-cta h2 {

  font-size:55px;

  line-height:1;

  margin:15px 0 25px;

}

.final-cta a {

  display:inline-block;

  padding:13px 20px;

  background:white;

  color:var(--orange);

  border-radius:7px;

  font-weight:800;

}


/* =====================================================
   FOOTER
===================================================== */

footer {

  background:#24140e;

  color:white;

  padding:70px 8% 25px;

}

.footer-brand .brand-logo {

  color:white;

}

.footer-brand p {

  color:#a9988d;

  margin-top:10px;

  font-size:12px;

}

.footer-links {

  display:flex;

  gap:25px;

  margin-top:35px;

  flex-wrap:wrap;

}

.footer-links a {

  color:#c6b7ac;

  font-size:11px;

}

.footer-links a:hover {

  color:white;

}

.footer-bottom {

  border-top:1px solid #49382f;

  margin-top:40px;

  padding-top:20px;

  color:#8e7d72;

  font-size:9px;

}


/* =====================================================
   MODALS
===================================================== */

.modal {

  position:fixed;

  inset:0;

  z-index:3000;

  display:none;

  align-items:center;

  justify-content:center;

  padding:20px;

  background:rgba(30,15,8,.7);

  backdrop-filter:blur(8px);

}

